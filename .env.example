# ===== WEBSITE (customer store) =====
# SAME database as the dashboard — both projects must point to the same MongoDB.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/laptop-clinic?retryWrites=true&w=majority

# Signs customer login cookies (can differ from the dashboard's secret). 32+ random chars.
AUTH_SECRET=

# This website's public address (order/reset emails + SEO). REQUIRED in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Your brand name (header, footer, emails, titles). More options in src/lib/site.ts
NEXT_PUBLIC_BRAND_NAME=The Aaruh
# Prefix of order numbers, e.g. OD-250101-AB12CD
ORDER_PREFIX=OD

# Emails via Resend
RESEND_API_KEY=
EMAIL_FROM=Laptop Clinic <onboarding@resend.dev>

# Razorpay (use the SAME keys in the dashboard — it issues refunds)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook URL: https://YOUR-WEBSITE/api/razorpay/webhook (events payment.captured, order.paid)
RAZORPAY_WEBHOOK_SECRET=

# Optional "Continue with Google" (customer sign-in)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Push notifications (optional): npx web-push generate-vapid-keys  → put the PUBLIC key here and in the dashboard
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
